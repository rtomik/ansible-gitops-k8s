adguard-home:
  ## Admin UI, served through Traefik
  ingress:
    enabled: true
    className: "traefik"
    annotations:
      traefik.ingress.kubernetes.io/router.entrypoints: websecure
    hosts:
      - host: adguard.{{ domain }}
        paths:
          - path: /
            pathType: Prefix
    tls:
      - hosts:
          - adguard.{{ domain }}

  ## DNS service, exposed on the LAN via a dedicated KubeVIP-assigned IP
  ## Point your router/clients' DNS at adguard_home.dns_vip for network-wide ad blocking.
  service:
    type: LoadBalancer
    annotations: {}
    loadBalancerIP: "{{ adguard_home.dns_vip }}"

  ## Persistence settings
  persistence:
    work:
      enabled: true
      storageClass: "longhorn"
      accessMode: ReadWriteOnce
      size: 1Gi
    conf:
      enabled: true
      storageClass: "longhorn"
      accessMode: ReadWriteOnce
      size: 100Mi
